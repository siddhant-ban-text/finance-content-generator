# Local configuration only. Copy to ignored .env and load explicitly with uv --env-file .env.
FINANCE_ENVIRONMENT=local
FINANCE_PUBLISHING_ENABLED=false
FINANCE_ALLOW_PAID_PROVIDERS=false
FINANCE_FAKE_STAGE_ENABLED=false
FINANCE_DATA_DIR=data
FINANCE_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
# Leave model/provider and GitHub credentials unset until their later slices.
